# ── SYSTEM CORE & TELEMETRY REGISTRY ──────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
TENANT_ID=76c4fbda-de68-4842-81f7-723319cfb6de
ORGANIZATION_ID=76c4fbda-de68-4842-81f7-723319cfb6de

# ── DATABASE STORAGE TIER ─────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kiHkQeExaYlr7tXj91BF

# Network Routing Parameters (Container Cross-Communication)
DATABASE_URL=postgresql+asyncpg://postgres:kiHkQeExaYlr7tXj91BF@postgres:5432/projectxy
DATABASE_URL_SYNC=postgresql://postgres:kiHkQeExaYlr7tXj91BF@postgres:5432/projectxy
# FIXED: previously pointed at port 5433 while nothing published Postgres to
# the host, so this could never connect. docker-compose.yml now publishes
# 5433:5432, so this works for host-side psql/DBeaver access.
DATABASE_URL_LOCAL=postgresql+asyncpg://postgres:kiHkQeExaYlr7tXj91BF@localhost:5433/projectxy
POSTGRES_DB=projectxy

# ── GRAPH DATABASE ENGINE [NEO4J] ──────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=LTkrhYlXdXqpI9sEKZp2
NEO4J_URI_LOCAL=bolt://localhost:7687

# ── CACHE & HIGH-THROUGHPUT PUB/SUB TIER ──────────────────────────────────────
REDIS_PASSWORD=8je5gfvNjiGQr7VRTo6Q
# FIXED: REDIS_URL had no password at all, and the Redis container is started
# with --requirepass. Any code that reads REDIS_URL directly (instead of building
# it from REDIS_PASSWORD) would get "NOAUTH Authentication required" errors.
# NOTE: env_file values are passed to containers as literal strings — Compose
# does NOT expand ${REDIS_PASSWORD} inside another env_file line — so the
# password is written out in full here rather than referenced.
REDIS_URL=redis://:8je5gfvNjiGQr7VRTo6Q@redis:6379/0

# ── BACKEND APPLICATION INTERFACE [FASTAPI] ────────────────────────────────────
PYTHONPATH=/app
# NOTE: docker-compose.yml overrides this to /app for backend/backend-seed/alembic
# anyway. ./backend only matters if you ever run the app outside Docker.
JWT_SECRET_KEY=f2a9b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2
# FIXED: was identical to JWT_SECRET_KEY. Using the same value for both means
# anything signed/encrypted with one secret is trivially valid under the other —
# generate these independently (e.g. `openssl rand -hex 32`).
SECRET_KEY=b7f1e4a2c9d6083f5a1e7c4b9d2f6a8e0c3b5d7f9a1c3e5b7d9f1a3c5e7b9d1f
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secure Data Ingress Mappings
FRONTEND_URL=http://localhost:3000
# FIXED: docker-compose.yml's backend service hardcodes ALLOW_ORIGINS=["*"] in its
# `environment:` block, which OVERRIDES this value entirely (env_file is loaded
# first, then `environment:` wins on conflicts) — so BACKEND_CORS_ORIGINS below
# was never actually reaching your app. Whichever variable name your FastAPI
# settings actually read (check app/core/config.py), only one was winning, and
# combining allow_origins=["*"] with allow_credentials=true is also invalid per
# the CORS spec — browsers reject credentialed requests against a wildcard
# origin even if the server sends it. Removed the ALLOW_ORIGINS override in the
# compose file (see note in the response) so this explicit origin list is used.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8001","http://127.0.0.1:3000"]

# Zero-Trust Operating Authorities
ADMIN_USER=admin@projectxy.com
ADMIN_PASSWORD=YwpaIZxlKuQLjScYP3qM
AUTH_BYPASS_ENABLED=false
AI_ADVISOR_PASSWORD=7EWWMeMjxTNwUYumFmZX
TEST_USER_PASSWORD=mpbKci8UJAMjG696HDwj

# ── FRONTEND PORTAL MATRIX [NEXT.JS 14] ───────────────────────────────────────
# REVISED given README's "backend port never exposed directly" design rule:
# the backend's host port (8001) is now removed entirely from docker-compose.yml,
# so a URL pointing at localhost:8001 can no longer work. In the full profile,
# Traefik terminates TLS on :443 and routes Host(`localhost`) && PathPrefix(`/api`)
# to the backend over the internal network — so the browser-facing URL is
# https://localhost/api/v1, not a direct backend port.
# Also note: NEXT_PUBLIC_* vars are baked in at Next.js BUILD time. Setting them
# under a service's runtime `environment:` does nothing to an already-built
# image — docker-compose.yml now passes these as `build.args` instead.
# VERIFY against frontend/src/lib/api.ts: if it expects a relative path (same
# origin) rather than an absolute URL, use NEXT_PUBLIC_API_URL=/api/v1 instead.
NEXT_PUBLIC_API_URL=https://localhost/api/v1
NEXT_PUBLIC_WS_URL=wss://localhost/api/v1

# ── OSINT INTELLIGENCE HARVESTER ENGINES ──────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
INTEL_X_API_KEY=
ALIENVAULT_API_KEY=
LEAK_LOOKUP_API_KEY=

