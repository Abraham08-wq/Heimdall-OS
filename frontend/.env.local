# ==============================================================================
#               PROJECT XY - UNIFIED SECRETS & CONFIGURATION
# Production-aligned: passwords match docker-compose.yml + schema.sql seeds
# ==============================================================================

# ── DATABASE TIER ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=projectxy
# Docker internal (backend container → postgres container)
DATABASE_URL=postgresql+asyncpg://postgres:password123@postgres:5432/projectxy
DATABASE_URL_SYNC=postgresql://postgres:password123@postgres:5432/projectxy
# Local dev (outside Docker)
DATABASE_URL_LOCAL=postgresql+asyncpg://postgres:password123@localhost:5433/projectxy

# ── GRAPH DATABASE ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Neo4j@ProjectXY2025
# Local dev override
NEO4J_URI_LOCAL=bolt://localhost:7687

# ── CACHE & PUB/SUB ───────────────────────────────────────────────────────────
# Docker internal: Redis with auth
REDIS_URL=redis://:projectxy_redis_2025@redis:6379/0
# Local dev
REDIS_URL_LOCAL=redis://:projectxy_redis_2025@localhost:6379/0

# ── KAFKA ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BOOTSTRAP_SERVERS_LOCAL=localhost:9092

# ── LLM (Local Ollama) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30

# ── BACKEND (FASTAPI) ─────────────────────────────────────────────────────────
PYTHONPATH=./backend
SECRET_KEY=f2a9b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2
JWT_SECRET_KEY=f2a9b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://localhost"]
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── FRONTEND (NEXTJS) ─────────────────────────────────────────────────────────
# IMPORTANT: Leave empty — frontend uses relative /api/* through Next.js proxy
# Setting this to localhost:8000 will BREAK the proxy and cause CORS errors
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=http://localhost:8001

# ── OSINT API KEYS (populate for live intel) ──────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
INTEL_X_API_KEY=
ALIENVAULT_API_KEY=
LEAK_LOOKUP_API_KEY=
NVD_API_KEY=

# ── SIEM / CHRONICLE (optional) ───────────────────────────────────────────────
CHRONICLE_API_KEY=
CHRONICLE_CUSTOMER_ID=

# ── DEFAULT CREDENTIALS (change after first login!) ───────────────────────────
# admin@projectxy.io    | password | System Administrator
# red@projectxy.io      | password | Red Team Operator
# blue@projectxy.io     | password | Blue Team Analyst
# purple@projectxy.io   | password | Purple Team Intel
# auditor@projectxy.io  | password | Compliance Auditor
FRONTEND_URL=https://localhost
