# ==============================================================================
#                 PROJECT XY - UNIFIED SECRETS & PATHS                          
# ==============================================================================

# ── DATABASE TIER ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=projectxy
# Docker internal (backend container → postgres container)
DATABASE_URL=postgresql+asyncpg://postgres:password123@postgres:5432/projectxy
DATABASE_URL_SYNC=postgresql://postgres:password123@postgres:5432/projectxy
# Local dev (outside Docker)
DATABASE_URL_LOCAL=postgresql+asyncpg://postgres:password123@localhost:5433/projectxy

# --- GRAPH TIER ---
# ── GRAPH DATABASE ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# Local dev override
NEO4J_URI_LOCAL=bolt://localhost:7687

# --- CACHE & PUB/SUB TIER ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your_redis_password

# --- BACKEND (FASTAPI) ---
PYTHONPATH=./backend
JWT_SECRET_KEY=f2a9b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2
SECRET_KEY=f2a9b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2
FRONTEND_URL=https://localhost
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ADMIN_USER=admin@projectxy.com
ADMIN_PASSWORD=password
AUTH_BYPASS_ENABLED=false
AI_ADVISOR_PASSWORD=your_ai_advisor_password
TEST_USER_PASSWORD=your_test_user_password

# --- FRONTEND (NEXTJS) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1

# --- OSINT API KEYS ---
# Required for real target discovery and de-masking
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
INTEL_X_API_KEY=
ALIENVAULT_API_KEY=
LEAK_LOOKUP_API_KEY=

# --- MISC ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# ==============================================================================
#         SECURITY ENHANCEMENT CONFIG — East African Fintech Hardening
# ==============================================================================

# --- CGNAT-Safe SOAR (Enhancement #1) ---
# Set to "true" to prevent blocking CGNAT IP ranges (Safaricom, Airtel, Telkom).
# When enabled, SOAR targets device fingerprints/JWT JTIs instead of raw IPs.
# NEVER set to "false" in production without understanding CGNAT collateral risk.
CGNAT_SAFE_MODE=true

# --- SIM Swap Velocity Filter (Enhancement #3) ---
# Time window (in seconds) for SIM swap + sensitive action velocity detection.
# Default: 900 = 15 minutes. Tune down for faster response, up for fewer false positives.
SIM_SWAP_VELOCITY_WINDOW_SECONDS=900

# --- Kafka Dead-Letter Queue (Enhancement #4) ---
# Maximum retry attempts before a message is archived to failed_telemetry table.
DLQ_MAX_RETRIES=4
# Number of DLQ messages before an alert is triggered (depth monitoring).
DLQ_ALERT_DEPTH_THRESHOLD=100

# --- LLM Firewall Localized Thresholds (Enhancement #2) ---
# Cosine similarity threshold to BLOCK (Swahili/Sheng vectors may need lower threshold)
FW_SIMILARITY_THRESHOLD=0.82
FW_WARN_THRESHOLD=0.70
# Embedding model for semantic similarity. Switch to multilingual if Swahili vectors needed.
# Options: all-MiniLM-L6-v2 (EN only), paraphrase-multilingual-MiniLM-L12-v2 (multilingual)
FW_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
FW_MAX_PROMPT_LENGTH=8192
FW_REPLAY_TTL_SECONDS=3600

# --- SOAR Webhook (for Splunk/Sentinel/PagerDuty) ---
# Leave empty to disable external alerting (SOC webhook)
SOAR_WEBHOOK_URL=

# --- Telco API Integration (for SIM swap detection) ---
# Endpoint of the telco API that emits DEVICE_IDENTITY_CHANGE events
# Supported: Safaricom DCI API, Airtel Partner API
TELCO_API_WEBHOOK_SECRET=generate_a_strong_secret_here
