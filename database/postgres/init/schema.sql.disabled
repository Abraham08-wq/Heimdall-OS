-- 6. Cognitive Shield & Compliance
CREATE TABLE IF NOT EXISTS semantic_logs (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    tenant_id TEXT NOT NULL DEFAULT 'default',
    entity_id TEXT NOT NULL DEFAULT 'anonymous',
    session_id TEXT,
    embedding vector(384),
    threat_score FLOAT4 DEFAULT 0.0,
    action TEXT DEFAULT 'PASS',
    prompt_hash TEXT,
    transformations_applied JSONB DEFAULT '[]',
    intent_classification TEXT,
    multi_stage_flag BOOLEAN DEFAULT FALSE,
    attack_pattern TEXT,
    layer1_score FLOAT4 DEFAULT 0.0,
    layer3_score FLOAT4 DEFAULT 0.0
);

CREATE TABLE IF NOT EXISTS threat_vectors (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    category VARCHAR(100) NOT NULL,
    description TEXT,
    embedding vector(384) NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    severity FLOAT4 DEFAULT 0.8,
    source VARCHAR(100) DEFAULT 'curated',
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS audit_logs (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    timestamp TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    actor_id TEXT NOT NULL DEFAULT 'system',
    action TEXT NOT NULL,
    resource_type TEXT,
    resource_id TEXT,
    tenant_id TEXT NOT NULL DEFAULT 'default',
    hash TEXT,
    previous_hash TEXT,
    metadata JSONB DEFAULT '{}'
);

CREATE TABLE IF NOT EXISTS missions (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    tenant_id TEXT NOT NULL DEFAULT 'default',
    target TEXT NOT NULL,
    status VARCHAR(50) DEFAULT 'PENDING'
);

CREATE TABLE IF NOT EXISTS siem_alerts (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    tenant_id TEXT NOT NULL DEFAULT 'default',
    severity VARCHAR(20) NOT NULL DEFAULT 'LOW',
    alert_type VARCHAR(100),
    title TEXT,
    resolved BOOLEAN DEFAULT FALSE
);